# Anthropic API key used by app/agent.py and evaluation/evaluator.py
ANTHROPIC_API_KEY=

# Matches the OTel Collector's gRPC receiver port in docker-compose.yml
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Shows up as the service name in Kibana traces
OTEL_SERVICE_NAME=llm-observability-demo

# Set to "true" only for the demo — logs full prompts/responses as span
# attributes (gen_ai.input.messages / gen_ai.output.messages). Costs more
# to store and is a real privacy consideration on anything beyond a demo.
OTEL_CAPTURE_CONTENT=false

# Model used by evaluation/evaluator.py's LLM-as-judge check. Independent
# from the agent's own model (ANTHROPIC_MODEL) — doesn't need to match.
EVAL_MODEL=claude-sonnet-4-5
